#!/usr/bin/env python3
"""llmq - ask an OpenAI-compatible LLM from your shell prompt.

Draws a TUI on /dev/tty and prints the chosen text on stdout, so a shell
widget can capture it with command substitution and drop it into the
command line buffer.
"""

from __future__ import annotations

import argparse
import curses
import json
import os
import queue
import shlex
import subprocess
import sys
import tempfile
import threading
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

ACCEPT_PREFIX = "__llmq_accept__:"

CONFIG_PATH = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "llmq"
    / "config.toml"
)

DEFAULTS = {
    "api": {
        "url": "https://api.openai.com/v1",
        "key": "",
        "key_command": "",
        "model": "gpt-4o-mini",
        "temperature": 0.2,
        "max_tokens": 1024,
        "timeout": 60,
    },
    "prompt": {
        "system": (
            "You are a terminal assistant. Reply with shell commands only. "
            "No prose, no explanation, no markdown fences. "
            "One command per line. If several approaches exist, give each on its own line."
        ),
        "include_context": True,
    },
    "ui": {
        "width_pct": 80,
        "height_pct": 60,
        "title": " llmq ",
    },
    "tmux": {
        "enabled": True,
        "width": "80%",
        "height": "60%",
    },
}


# --------------------------------------------------------------------------
# config
# --------------------------------------------------------------------------


def deep_merge(base: dict, over: dict) -> dict:
    out = {k: (v.copy() if isinstance(v, dict) else v) for k, v in base.items()}
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


class ConfigError(Exception):
    """Config is missing or unreadable — worth saying so instead of guessing."""


def load_config(path: Path | None = None) -> dict:
    path = path or CONFIG_PATH
    if not path.exists():
        raise ConfigError(
            f"no config at {path}\n"
            f"  mkdir -p {path.parent}\n"
            f"  cp config.example.toml {path}   # then set url + key"
        )
    try:
        with path.open("rb") as fh:
            user = tomllib.load(fh)
    except tomllib.TOMLDecodeError as exc:
        raise ConfigError(f"{path}: {exc}") from None
    return deep_merge(DEFAULTS, user)


def resolve_key(api: dict) -> str:
    """Key can be literal, $ENV_VAR, or the stdout of key_command."""
    cmd = api.get("key_command") or ""
    if cmd:
        res = subprocess.run(
            shlex.split(cmd), capture_output=True, text=True, check=True
        )
        return res.stdout.strip()
    key = (api.get("key") or "").strip()
    if key.startswith("$"):
        return os.environ.get(key[1:], "")
    return key


def endpoint_url(url: str) -> str:
    u = url.rstrip("/")
    if u.endswith("/chat/completions"):
        return u
    return u + "/chat/completions"


ERR_PREFIX = "__llmq_error__:"


# --------------------------------------------------------------------------
# api
# --------------------------------------------------------------------------


def stream_completion(cfg: dict, messages: list[dict], out: queue.Queue, stop: threading.Event) -> None:
    api = cfg["api"]
    body = {
        "model": api["model"],
        "messages": messages,
        "stream": True,
        "temperature": api["temperature"],
        "max_tokens": api["max_tokens"],
    }
    headers = {"Content-Type": "application/json"}
    key = ""
    try:
        key = resolve_key(api)
    except Exception as exc:  # key_command blew up
        out.put(("error", f"key_command failed: {exc}"))
        out.put(("done", None))
        return
    if key:
        headers["Authorization"] = f"Bearer {key}"

    req = urllib.request.Request(
        endpoint_url(api["url"]),
        data=json.dumps(body).encode(),
        headers=headers,
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=api["timeout"]) as resp:
            for raw in resp:
                if stop.is_set():
                    break
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if payload == "[DONE]":
                    break
                try:
                    obj = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                choices = obj.get("choices") or [{}]
                delta = choices[0].get("delta") or {}
                chunk = delta.get("content")
                if chunk:
                    out.put(("chunk", chunk))
    except urllib.error.HTTPError as exc:
        detail = exc.read()[:400].decode("utf-8", "replace")
        out.put(("error", f"HTTP {exc.code}: {detail}"))
    except Exception as exc:
        out.put(("error", f"{type(exc).__name__}: {exc}"))
    finally:
        out.put(("done", None))


# --------------------------------------------------------------------------
# text handling
# --------------------------------------------------------------------------


def selectable_lines(text: str) -> list[str]:
    """Split the reply into pickable logical lines, dropping markdown fences."""
    lines = []
    for line in text.splitlines():
        if line.strip().startswith("```"):
            continue
        if line.strip():
            lines.append(line.rstrip())
    return lines


def wrap(line: str, width: int) -> list[str]:
    if width < 4:
        return [line]
    if not line:
        return [""]
    return [line[i : i + width] for i in range(0, len(line), width)] or [""]


# --------------------------------------------------------------------------
# ui
# --------------------------------------------------------------------------


class Ui:
    ASK, STREAM, BROWSE = range(3)

    def __init__(self, stdscr, cfg: dict, context: str):
        self.scr = stdscr
        self.cfg = cfg
        self.context = context
        self.state = self.ASK
        self.query = ""
        self.cursor = 0
        self.buffer = ""
        self.error = ""
        self.lines: list[str] = []
        self.sel = 0
        self.scroll = 0
        self.q: queue.Queue = queue.Queue()
        self.stop = threading.Event()
        self.worker: threading.Thread | None = None
        self.result: str | None = None

    # -- geometry ----------------------------------------------------------

    # Below this the box has no room for a border + prompt + one answer line.
    MIN_W = 30
    MIN_H = 6

    def box(self):
        h, w = self.scr.getmaxyx()
        # Clamp to the screen LAST: a 40-column floor on a 38-column terminal
        # gives a negative origin, and derwin() then returns NULL.
        bw = min(max(40, w * self.cfg["ui"]["width_pct"] // 100), max(self.MIN_W, w - 2))
        bh = min(max(8, h * self.cfg["ui"]["height_pct"] // 100), max(self.MIN_H, h - 2))
        return max(0, (h - bh) // 2), max(0, (w - bw) // 2), bh, bw

    # -- drawing -----------------------------------------------------------

    def draw(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        if h < self.MIN_H or w < self.MIN_W:
            try:
                self.scr.addnstr(0, 0, "llmq: terminal too small", max(0, w - 1))
            except curses.error:
                pass
            self.scr.refresh()
            return
        top, left, bh, bw = self.box()
        win = self.scr.derwin(bh, bw, top, left)
        win.box()
        title = self.cfg["ui"]["title"]
        if len(title) < bw - 4:
            win.addstr(0, 2, title, curses.A_BOLD)

        inner_w = bw - 4
        # prompt line
        prompt = "ask> " if self.state == self.ASK else "  q> "
        shown = self.query[-(inner_w - len(prompt)) :]
        win.addstr(1, 2, (prompt + shown)[:inner_w], curses.A_BOLD)
        win.hline(2, 1, curses.ACS_HLINE, bw - 2)

        body_top, body_h = 3, bh - 5
        if self.error:
            for i, row in enumerate(wrap(self.error, inner_w)[:body_h]):
                win.addstr(body_top + i, 2, row, curses.A_BOLD)
        elif self.state == self.STREAM:
            rows = []
            for line in self.buffer.splitlines() or [""]:
                rows.extend(wrap(line, inner_w))
            for i, row in enumerate(rows[-body_h:]):
                win.addstr(body_top + i, 2, row[:inner_w])
        elif self.state == self.BROWSE:
            rows = []  # (logical_index, text)
            for idx, line in enumerate(self.lines):
                for piece in wrap(line, inner_w):
                    rows.append((idx, piece))
            first = next((i for i, r in enumerate(rows) if r[0] == self.sel), 0)
            last = next((i for i in range(len(rows) - 1, -1, -1) if rows[i][0] == self.sel), 0)
            if first < self.scroll:
                self.scroll = first
            if last >= self.scroll + body_h:
                self.scroll = last - body_h + 1
            for i, (idx, piece) in enumerate(rows[self.scroll : self.scroll + body_h]):
                attr = curses.A_REVERSE if idx == self.sel else curses.A_NORMAL
                win.addstr(body_top + i, 2, piece.ljust(inner_w)[:inner_w], attr)

        win.hline(bh - 2, 1, curses.ACS_HLINE, bw - 2)
        win.addstr(bh - 2, 2, self.hint()[:inner_w])
        if self.state == self.ASK:
            curses.curs_set(1)
            win.move(1, min(2 + len(prompt) + len(shown), bw - 2))
        else:
            curses.curs_set(0)
        self.scr.refresh()
        win.refresh()

    def hint(self):
        if self.state == self.ASK:
            return " enter send · esc cancel "
        if self.state == self.STREAM:
            return " streaming… · esc abort "
        return " enter insert · ^a insert all · ^x insert+run · esc cancel "

    # -- input -------------------------------------------------------------

    def submit(self):
        self.state = self.STREAM
        self.buffer = ""
        self.error = ""
        messages = [{"role": "system", "content": self.cfg["prompt"]["system"]}]
        user = self.query
        if self.cfg["prompt"]["include_context"] and self.context.strip():
            user += f"\n\n[current command line: {self.context.strip()}]"
        messages.append({"role": "user", "content": user})
        self.worker = threading.Thread(
            target=stream_completion,
            args=(self.cfg, messages, self.q, self.stop),
            daemon=True,
        )
        self.worker.start()

    def pump(self):
        try:
            while True:
                kind, payload = self.q.get_nowait()
                if kind == "chunk":
                    self.buffer += payload
                elif kind == "error":
                    self.error = payload
                elif kind == "done":
                    self.lines = selectable_lines(self.buffer)
                    self.sel = 0
                    self.scroll = 0
                    self.state = self.BROWSE if self.lines else self.ASK
        except queue.Empty:
            pass

    def handle(self, ch: int) -> bool:
        """Return False to exit the loop."""
        if ch == 27:  # esc
            if self.state == self.STREAM:
                self.stop.set()
                self.state = self.ASK
                return True
            return False

        if self.state == self.ASK:
            if ch in (curses.KEY_ENTER, 10, 13):
                if self.query.strip():
                    self.submit()
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                self.query = self.query[:-1]
            elif ch == 21:  # ^u
                self.query = ""
            elif ch == 23:  # ^w
                self.query = self.query.rstrip().rsplit(" ", 1)[0] if " " in self.query.strip() else ""
            elif 32 <= ch < 127:
                self.query += chr(ch)
            return True

        if self.state == self.BROWSE:
            if ch in (curses.KEY_DOWN, ord("j"), 14):
                self.sel = min(self.sel + 1, len(self.lines) - 1)
            elif ch in (curses.KEY_UP, ord("k"), 16):
                self.sel = max(self.sel - 1, 0)
            elif ch in (curses.KEY_ENTER, 10, 13):
                self.result = self.lines[self.sel]
                return False
            elif ch == 1:  # ^a
                self.result = "\n".join(self.lines)
                return False
            elif ch == 24:  # ^x
                self.result = ACCEPT_PREFIX + self.lines[self.sel]
                return False
            elif ch in (ord("e"), ord("/")):  # back to editing
                self.state = self.ASK
            return True

        return True

    # -- loop --------------------------------------------------------------

    TICK = 50  # ms between repaints while streaming

    ESC_SEQ = {
        "[A": curses.KEY_UP, "OA": curses.KEY_UP,
        "[B": curses.KEY_DOWN, "OB": curses.KEY_DOWN,
        "[C": curses.KEY_RIGHT, "OC": curses.KEY_RIGHT,
        "[D": curses.KEY_LEFT, "OD": curses.KEY_LEFT,
        "[5~": curses.KEY_PPAGE,
        "[6~": curses.KEY_NPAGE,
    }

    def read_key(self) -> int:
        """getch() with a short input timeout hands back a bare 27 when an
        escape sequence straddles the poll window. Reassemble it ourselves."""
        ch = self.scr.getch()
        if ch != 27:
            return ch
        self.scr.nodelay(True)
        try:
            seq = []
            for _ in range(5):
                nxt = self.scr.getch()
                if nxt == -1:
                    break
                seq.append(nxt)
        finally:
            self.scr.nodelay(False)
            self.scr.timeout(self.TICK)
        if not seq:
            return 27  # a real Escape press
        text = "".join(chr(c) for c in seq if 0 <= c < 256)
        return self.ESC_SEQ.get(text, -1)  # unknown sequence: swallow it

    def run(self) -> str | None:
        curses.use_default_colors()
        self.scr.timeout(self.TICK)
        while True:
            self.pump()
            self.draw()
            try:
                ch = self.read_key()
            except KeyboardInterrupt:
                return None
            if ch in (-1, curses.KEY_RESIZE):
                continue
            if not self.handle(ch):
                return self.result


# --------------------------------------------------------------------------
# plumbing
# --------------------------------------------------------------------------


def in_tmux_popup_mode(cfg: dict, args) -> bool:
    return (
        cfg["tmux"]["enabled"]
        and os.environ.get("TMUX")
        and not args.popup_out
        and not args.no_popup
    )


def run_via_tmux(cfg: dict, args) -> str | None:
    fd, path = tempfile.mkstemp(prefix="llmq-")
    os.close(fd)
    me = os.path.abspath(sys.argv[0])
    # Mirror llmq.fish: fall back to the interpreter if the script isn't +x,
    # otherwise tmux exits 126 and -E hides the failure completely.
    inner = ([me] if os.access(me, os.X_OK) else [sys.executable, me])
    inner += ["--popup-out", path]
    if args.context:
        inner += ["--context", args.context]
    if args.config:
        inner += ["--config", args.config]
    subprocess.run(
        [
            "tmux", "display-popup", "-E",
            "-w", str(cfg["tmux"]["width"]),
            "-h", str(cfg["tmux"]["height"]),
            "-T", cfg["ui"]["title"].strip(),
            shlex.join(inner),
        ]
    )
    try:
        data = Path(path).read_text()
    except OSError:
        data = ""
    finally:
        Path(path).unlink(missing_ok=True)

    if data.startswith(ERR_PREFIX):
        print(f"llmq: {data[len(ERR_PREFIX):]}", file=sys.stderr)
        return None
    return data or None


def main() -> int:
    ap = argparse.ArgumentParser(prog="llmq", description=__doc__)
    ap.add_argument("--context", default="", help="current command line, sent as context")
    ap.add_argument("--config", default="", help="path to config.toml")
    ap.add_argument("--popup-out", default="", help="internal: write result here instead of stdout")
    ap.add_argument("--no-popup", action="store_true", help="never use the tmux popup")
    ap.add_argument("--print-config", action="store_true", help="dump effective config and exit")
    args = ap.parse_args()

    try:
        cfg = load_config(Path(args.config) if args.config else None)
    except ConfigError as exc:
        if args.print_config:  # still useful: show what the defaults are
            print(json.dumps(deep_merge(DEFAULTS, {}), indent=2))
            return 0
        # stderr, not stdout: stdout is the pipe fish pastes into the prompt.
        print(f"llmq: {exc}", file=sys.stderr)
        return 2

    if args.print_config:
        print(json.dumps(cfg, indent=2))
        return 0

    if in_tmux_popup_mode(cfg, args):
        result = run_via_tmux(cfg, args)
        if result:
            sys.stdout.write(result)
        return 0

    # Keep a handle on the real stdout, then point fd 1 at the terminal so
    # curses draws on the tty even when our stdout is a capture pipe.
    saved_out = os.dup(1)
    if not os.isatty(1):
        tty = os.open("/dev/tty", os.O_WRONLY)
        os.dup2(tty, 1)
        os.close(tty)
    if not os.isatty(0):
        tty_in = os.open("/dev/tty", os.O_RDONLY)
        os.dup2(tty_in, 0)
        os.close(tty_in)

    os.environ.setdefault("ESCDELAY", "25")
    try:
        result = curses.wrapper(lambda scr: Ui(scr, cfg, args.context).run())
    except Exception as exc:
        # `display-popup -E` tears the popup down the instant we exit, so a
        # traceback printed here would never be readable. Hand it to the parent
        # through the result file instead; it prints to stderr after the popup
        # is gone. Outside a popup, stderr is already visible — just use it.
        msg = f"{type(exc).__name__}: {exc}"
        if args.popup_out:
            Path(args.popup_out).write_text(ERR_PREFIX + msg)
        else:
            print(f"llmq: {msg}", file=sys.stderr)
        return 1

    if not result:
        return 0
    if args.popup_out:
        Path(args.popup_out).write_text(result)
    else:
        os.write(saved_out, result.encode())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
